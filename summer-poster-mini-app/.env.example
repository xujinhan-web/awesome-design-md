# Copy this file to .env.local and paste your own token.
# Do not commit real API keys.

# Recommended if you cannot access Hugging Face.
GEMINI_API_KEY=
# Optional Gemini image model. Default: gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional fallback provider.
HUGGINGFACE_API_KEY=
# Optional Hugging Face image model.
# HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
